{
  "app": {
    "language": "es",
    "theme_accent": "#d97706",
    "theme_mode": "light",
    "window_title": "Sistema de visión artificial para el direccionamiento de un dron virtual"
  },
  "camera": {
    "default_index": 0,
    "probe_count": 5,
    "mirror": true,
    "frame_interval_ms": 30
  },
  "vision": {
    "hand_padding": 0.3,
    "min_detection_confidence": 0.5,
    "min_tracking_confidence": 0.5,
    "max_num_hands": 1,
    "min_roi_size_px": 5
  },
  "models": {
    "manifest": "models/manifest.json",
    "default": "resnet18"
  },
  "inference": {
    "preferred_device": "directml",
    "fallback_device": "cpu",
    "min_confidence": 0.95
  },
  "commands": {
    "mapping": "config/gesture_commands.json",
    "stability_frames": 5,
    "send_rate_hz": 2.0,
    "repeat_same_command_s": 1.0,
    "no_hand_behavior": "detener",
    "low_confidence_behavior": "detener"
  },
  "airsim": {
    "enabled": true,
    "ip": "127.0.0.1",
    "port": 41451,
    "timeout_s": 5.0,
    "vehicle_name": "",
    "forward_speed_mps": 3.5,
    "lateral_speed_mps": 3.0,
    "vertical_speed_mps": 2.2,
    "yaw_rate_deg_s": 45.0,
    "movement_duration_s": 2.5,
    "motion_refresh_s": 2.0,
    "use_body_frame": true
  },
  "logs": {
    "directory": "logs"
  }
}
